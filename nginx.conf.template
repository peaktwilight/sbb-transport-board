server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Block access to secrets and config files
    location ~* (secrets\.js|\.env|\.git) {
        return 404;
    }

    # Proxy kitchen shame API to WAHA
    

    location / {
        try_files $uri $uri/ /index.html;
    }
}
